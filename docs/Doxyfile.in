PROJECT_NAME    = "PEREDUR"
PROJECT_NUMBER  = "@PROJECT_VERSION@"

INPUT           = @CMAKE_SOURCE_DIR@/include
RECURSIVE       = YES
FILE_PATTERNS   = *.hpp *.h *.cpp

OUTPUT_DIRECTORY = @DOXYGEN_OUTPUT_DIR@
GENERATE_HTML   = NO
GENERATE_XML    = YES
# Breathe consumes the XML alone. Doxygen defaults GENERATE_LATEX to YES, which
# needs epstopdf to convert images and, under WARN_AS_ERROR, fails the build
# where no TeX installation exists -- for output nothing reads.
GENERATE_LATEX  = NO
XML_OUTPUT      = xml

EXTRACT_ALL     = YES
QUIET           = YES
WARN_AS_ERROR   = YES
