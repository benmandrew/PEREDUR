+# The PSP campaign (peredur experiments/2026-11-20-psp-order): sweep F's base,
+# full and every no-<f> under nsga2-apportion, blame on in every arm, on the
+# PSP specifications (results-psp-order.csv: the hand-written subjects and the
+# unrealisable SYNTECH17 imports) and the PSP seeded corpus
+# (results-psp-order-seeded.csv), with its pooled pass (pooled-*-psp.csv) and
+# trivial-reversion probe (psp-seeded-probe.csv). Every file is optional: a
+# missing one leaves its keys missing. Its keys sit under psp-* levels.
+PSP_RESULTS = "results-psp-order.csv"
+PSP_SEEDED_RESULTS = "results-psp-order-seeded.csv"
+PSP_FEATURES = ("climb", "gate", "remove", "novelty")
+PSP_CONTRASTS = ((FULL, BASELINE),) + tuple((f"no-{f}", FULL) for f in PSP_FEATURES)
+# The hand-written subjects have fixes, so a known repair; the SYNTECH17
+# imports (prefix syntech-) have none, so the known-repair rate is over these.
+PSP_IDEAL_PREFIX = "psp-"
+# A seeded subject is <base>__m<k>; its cluster is its base.
+PSP_SEEDED_SEP = "__"
+PSP_PROBE = "psp-seeded-probe.csv"
+PSP_PROBE_THRESHOLD = 0.01
+PSP_POOLED_STRENGTH = "pooled-strength-psp.csv"
+PSP_POOLED_BALLS = "pooled-balls-psp.csv"
+PSP_POOLED_SHARE = "pooled-share-psp.csv"
+# The pooled design's contrasts the paper reads (make_design.py of
+# 2026-11-20-psp-order-pooled); its family joint only fixes the joint front.
+PSP_POOLED_PAIRS = {FULL: (FULL, BASELINE), "no-climb-over-base": ("no-climb", BASELINE),
+                    **{f"no-{f}": (f"no-{f}", FULL) for f in PSP_FEATURES}}
+PSP_POOLED_FAMILIES = {"base": (FULL, "no-climb-over-base"),
+                       "ablation": tuple(f"no-{f}" for f in PSP_FEATURES)}
+
+
+def psp_runs(name):
+    """The file's nsga2-apportion runs by arm, then (spec, seed); {} when the
+    file has not been imported."""
+    arms = defaultdict(dict)
+    if (DATA / name).exists():
+        for row in read_csv(name):
+            if row["selection"] == SELECTION:
+                arms[row["level_name"]][(row["spec"], int(row["seed"]))] = row
+    return arms
+
+
+def psp_rates(results, prefix):
+    """Per arm: runs, found-repair and known-repair rates, repairs and wall
+    time, overall and per specification; per contrast of PSP_CONTRASTS: McNemar
+    on both rates and the Hodges-Lehmann wall-time shift over paired runs,
+    Holm over the four features within each measure."""
+    levels = {}
+    for arm, runs in results.items():
+        keys = sorted(runs)
+        ideal_keys = [k for k in keys if k[0].startswith(PSP_IDEAL_PREFIX)]
+        entry = levels[f"{prefix}{arm}"] = {
+            "runs": len(keys), "specs": len({k[0] for k in keys}),
+            "repairs": describe([int(runs[k]["n_repairs"] or 0) for k in keys]),
+            "wall": describe([float(runs[k]["wall_time_s"]) for k in keys]),
+            "found": {"rate": rate(runs, keys, "found_repair"), "runs": len(keys)},
+            "spec": {}}
+        if ideal_keys:
+            entry["ideal"] = {"rate": rate(runs, ideal_keys, "implies_ideal"),
+                              "runs": len(ideal_keys)}
+        for spec in sorted({k[0] for k in keys}):
+            sk = [k for k in keys if k[0] == spec]
+            entry["spec"][spec] = {"found": rate(runs, sk, "found_repair"),
+                                   "ideal": rate(runs, sk, "implies_ideal"),
+                                   "runs": len(sk),
+                                   "wall": describe([float(runs[k]["wall_time_s"])
+                                                     for k in sk])}
+
+    def contrast(arm, ref):
+        a, b = results[arm], results[ref]
+        keys = sorted(a.keys() & b.keys())
+        ideal_keys = [k for k in keys if k[0].startswith(PSP_IDEAL_PREFIX)]
+        aw = [float(a[k]["wall_time_s"]) for k in keys]
+        bw = [float(b[k]["wall_time_s"]) for k in keys]
+        diffs = [x - y for x, y in zip(aw, bw)]
+        out = {"found": mcnemar(outcome(a, keys, "found_repair"),
+                                outcome(b, keys, "found_repair")),
+               "wall": {**hodges_lehmann(diffs, record=False), "p": signrank_p(diffs),
+                        "median": {"arm": float(np.median(aw)),
+                                   "ref": float(np.median(bw))}}}
+        if ideal_keys:
+            out["ideal"] = mcnemar(outcome(a, ideal_keys, "implies_ideal"),
+                                   outcome(b, ideal_keys, "implies_ideal"))
+        return out
+
+    for arm, ref in PSP_CONTRASTS:
+        if arm in results and ref in results:
+            levels[f"{prefix}{arm}"].setdefault("vs", {})[ref] = contrast(arm, ref)
+    ablated = [f"{prefix}no-{f}" for f in PSP_FEATURES
+               if FULL in levels.get(f"{prefix}no-{f}", {}).get("vs", {})]
+    summary = {}
+    for measure in ("found", "ideal", "wall"):
+        ps = {arm: levels[arm]["vs"][FULL][measure]["p"] for arm in ablated
+              if measure in levels[arm]["vs"][FULL]}
+        for arm, h in holm(ps).items():
+            levels[arm]["vs"][FULL][measure]["holm"] = h
+        summary[f"significant_{measure}"] = sum(
+            levels[arm]["vs"][FULL][measure]["holm"] < ALPHA for arm in ps)
+    if ablated:
+        levels[f"{prefix}ablation"] = summary
+    return levels
+
+
+def psp_seeded():
+    """The PSP seeded corpus as seeded() reads the FRETISH one: per-subject
+    means over seeds, contrasts with a cluster bootstrap over bases, Holm over
+    the four features; over every subject, and over the probe's headline
+    subjects (both reversion shares under PSP_PROBE_THRESHOLD) once it has run."""
+    if not (DATA / PSP_SEEDED_RESULTS).exists():
+        return {}
+    rows = [r for r in read_csv(PSP_SEEDED_RESULTS) if r["selection"] == SELECTION]
+    cells = seeded_cells(rows)
+    subjects = sorted({r["spec"] for r in rows})
+    cluster_of = {s: s.split(PSP_SEEDED_SEP)[0] for s in subjects}
+    levels = seeded_levels(cells, subjects, cluster_of, "psp-seeded-", PSP_FEATURES)
+    summary = {"runs": len(rows), "subjects": len(subjects),
+               "clusters": len(set(cluster_of.values()))}
+    if (DATA / PSP_PROBE).exists():
+        probe = {r["subject"]: r for r in read_csv(PSP_PROBE)}
+        probed = [s for s in subjects if s in probe]
+        p1 = {s: float(probe[s]["p1"]) for s in probed}
+        p2 = {s: float(probe[s]["p2"]) for s in probed}
+        headline = [s for s in probed
+                    if p1[s] < PSP_PROBE_THRESHOLD and p2[s] < PSP_PROBE_THRESHOLD]
+        summary["probe"] = {
+            "threshold": PSP_PROBE_THRESHOLD, "subjects": len(probed),
+            "headline": len(headline), "trivial": len(probed) - len(headline),
+            "p1_mean": math.fsum(p1.values()) / len(p1) if p1 else float("nan"),
+            "p2_mean": math.fsum(p2.values()) / len(p2) if p2 else float("nan"),
+            "p1_max": max(p1.values(), default=float("nan")),
+            "p2_max": max(p2.values(), default=float("nan"))}
+        if headline:
+            levels.update(seeded_levels(cells, headline, cluster_of,
+                                        "psp-seeded-headline-", PSP_FEATURES))
+    levels["psp-seeded"] = summary
+    return levels
+
+
+def psp_pooled():
+    """The pooled measures of the PSP pass, as pooled() computes them, apart
+    for the specifications (psp-pooled-<contrast>) and the seeded corpus
+    (psp-seeded-pooled-<contrast>)."""
+    def rows(name, seeded):
+        if not (DATA / name).exists():
+            return []
+        out = []
+        for r in read_csv(name):
+            if (PSP_SEEDED_SEP in r["subject"]) != seeded:
+                continue
+            if "contrast" in r:
+                if r["contrast"] not in PSP_POOLED_PAIRS:
+                    continue
+            if "arm" in r:
+                r = {**r, "arm": r["arm"].rsplit("/", 1)[-1]}
+            out.append(r)
+        return out
+
+    levels = {}
+    for seeded, prefix in ((False, "psp-pooled-"), (True, "psp-seeded-pooled-")):
+        out = defaultdict(dict)
+        strength = rows(PSP_POOLED_STRENGTH, seeded)
+        balls = rows(PSP_POOLED_BALLS, seeded)
+        share = rows(PSP_POOLED_SHARE, seeded)
+        if strength:
+            pooled_families(out, strength, balls, PSP_POOLED_FAMILIES)
+        if share:
+            pooled_share(out, share, PSP_POOLED_FAMILIES, pairs=PSP_POOLED_PAIRS)
+            pooled_reach(out, share, PSP_POOLED_FAMILIES, pairs=PSP_POOLED_PAIRS)
+        levels.update({f"{prefix}{c}": entry for c, entry in out.items()})
+    return levels
+
+
+def psp():
+    return (psp_rates(psp_runs(PSP_RESULTS), "psp-")
+            | psp_seeded() | psp_pooled())
+
+
 def describe(values):
     v = np.asarray(values, dtype=float)
     q1, med, q3 = np.percentile(v, [25, 50, 75])
@@ -1058,6 +1239,10 @@ def main():
     exchange_base(stats["levels"], {spec for spec, _ in counters[BASELINE]})
     stats["levels"].update(interval_check())
     stats["levels"].update(seeded())
+    # After interval_check, so the PSP intervals leave its counts as they were.
+    global RECORDING
+    RECORDING = False
+    stats["levels"].update(psp())
 
     (DATA / "stats.json").write_text(json.dumps(stats, indent=1) + "\n")
     (DATA / "stats.tex").write_text(to_tex(stats))
