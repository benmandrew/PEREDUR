+def import_psp(checkout):
+    """Copy the PSP campaign's results and pooled outputs from checkout, and
+    flatten its run.json counters into counters-<profile>.csv."""
+    experiments = checkout / "experiments"
+    for name in PSP_RUNS:
+        results = experiments / f"results-{name}.csv"
+        if not results.exists():
+            print(f"{name}: no {results}; keeping data/")
+            continue
+        shutil.copyfile(results, DATA / results.name)
+        rows = [{**run_labels(run_json.parent), **counters(run_json)}
+                for run_json in sorted((experiments / f"results-{name}").glob("*/run.json"))]
+        if rows:
+            write_rows(DATA / f"counters-{name}.csv", rows)
+        print(f"{name}: {len(rows)} runs from {experiments}")
+    for source, name in PSP_FILES:
+        if (checkout / source).exists():
+            shutil.copyfile(checkout / source, DATA / name)
+            print(f"{name} from {checkout / source}")
+        else:
+            print(f"{name}: no {checkout / source}; keeping data/")
