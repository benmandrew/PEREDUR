# Generated by cmake/install.cmake. Source this to point an installed PEREDUR
# at the solvers installed beside it:
#
#     . <prefix>/@PEREDUR_DATA_DIR@/peredur-env.sh
#
# Every path PEREDUR spawns is compiled in as an absolute path into the build
# tree it was built from, and these variables override that. Without them an
# installed binary still reaches for a build directory that may not exist.
# Resolved from this file's own location, so the tree stays relocatable.
_peredur_prefix=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/../.." && pwd)

PEREDUR_SPOT_BIN_DIR="$_peredur_prefix/@PEREDUR_TOOL_DIR@/spot/bin"
PEREDUR_GANAK_PATH="$_peredur_prefix/@PEREDUR_TOOL_DIR@/ganak"
PEREDUR_BLACK_PATH="$_peredur_prefix/@PEREDUR_TOOL_DIR@/black/bin/black"
PEREDUR_FORMALISER_SCRIPT="$_peredur_prefix/@PEREDUR_DATA_DIR@/fretCLI.main.js"
PEREDUR_DASHBOARD_PAGE="$_peredur_prefix/@PEREDUR_DATA_DIR@/dashboard.html"

export PEREDUR_SPOT_BIN_DIR PEREDUR_GANAK_PATH PEREDUR_BLACK_PATH
export PEREDUR_FORMALISER_SCRIPT PEREDUR_DASHBOARD_PAGE
unset _peredur_prefix
