#!/bin/sh
# Generated by cmake/install.cmake. Spot's binaries carry an absolute RUNPATH
# naming the lib directory of the build tree they were configured in, so a copy
# of one anywhere else cannot find libspot. LD_LIBRARY_PATH is searched ahead of
# RUNPATH, which is what this restores. Resolved from $0 rather than baked in,
# so the installed tree survives being moved, copied into an image, or given a
# different --prefix.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LD_LIBRARY_PATH="$here/../lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$here/../libexec/@PEREDUR_WRAPPED_TOOL@" "$@"
