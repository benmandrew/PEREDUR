#!/bin/sh
set -e

# Every check here shells out to a build target, so the build directory must
# already be configured. That is also what installs this hook: see
# cmake/githooks.cmake.
REPO_ROOT=$(git rev-parse --show-toplevel)

if [ ! -d "$REPO_ROOT/build" ]; then
    echo "pre-commit: $REPO_ROOT/build is not configured; skipping checks."
    echo "            Run 'cmake --preset debug' to enable them."
    exit 0
fi

# Formatting is judged on the staged contents, so a partly staged file is
# checked as it will be committed rather than as it sits in the working tree.
# The clang-format is the one configure resolved (cmake/find_tool.cmake).
echo "Checking formatting of staged files..."
clang_format=$(sed -n 's/^CLANG_FORMAT_EXE:FILEPATH=//p' "$REPO_ROOT/build/CMakeCache.txt")
if [ -z "$clang_format" ] || [ ! -x "$clang_format" ]; then
    echo "pre-commit: build/ has no usable clang-format ($clang_format)."
    echo "            Re-run 'cmake --preset debug' inside nix develop."
    exit 1
fi
unformatted=0
staged=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'src/*.cpp' 'src/*.hpp' 'src/*.h' 'test/*.cpp' 'test/*.hpp' 'test/*.h' \
    'bench/*.cpp' 'bench/*.hpp' 'bench/*.h' 'fuzz/*.cpp' 'fuzz/*.hpp' \
    'fuzz/*.h' 'include/*.hpp' 'include/*.h')
for file in $staged; do
    if ! git show ":$file" | "$clang_format" --dry-run --Werror \
            --assume-filename="$REPO_ROOT/$file" >/dev/null 2>&1; then
        echo "  not formatted (staged version): $file"
        unformatted=1
    fi
done
if [ "$unformatted" -ne 0 ]; then
    echo "Run 'cmake --build build --target format' and stage the result."
    exit 1
fi

# cpplint and cppcheck read files from disk, so they see the working tree.

echo "Running cpplint and cppcheck..."
cmake --build "$REPO_ROOT/build" --target lint-cpplint lint-cppcheck

# Guarded so the hook still works on branches predating the target, where
# ninja would abort with "unknown target".
if [ -f "$REPO_ROOT/scripts/check_config_schema.py" ]; then
    echo "Checking gen_configs defaults..."
    cmake --build "$REPO_ROOT/build" --target lint-config-schema
fi

echo "Building docs..."
cmake --build "$REPO_ROOT/build" --target docs
