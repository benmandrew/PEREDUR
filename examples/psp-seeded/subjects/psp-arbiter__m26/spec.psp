{
  "assumptions": [
    {
      "pattern": "universality",
      "s": "!((start) & (stop))",
      "scope": "globally"
    }
  ],
  "guarantees": [
    {
      "count": 1,
      "p": "req",
      "pattern": "bounded-response",
      "q": "start",
      "r": "stop",
      "s": "grant",
      "scope": "afteruntil"
    },
    {
      "count": 1,
      "p": "!(stop)",
      "pattern": "bounded-response",
      "q": "start",
      "r": "stop",
      "s": "!(grant)",
      "scope": "afteruntil"
    }
  ],
  "in_atoms": [
    "req",
    "start",
    "stop"
  ],
  "out_atoms": [
    "grant"
  ]
}
