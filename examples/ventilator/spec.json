      "condition": "pcv_mode",
      "condition-type": "continual",
      "response": "(breathing_cycle_time_eq_1_div_rr_pcv & expiratory_time_eq_breathing_cycle_time_div_1_plus_ito_e_pcv)",
      "timing": {
        "type": "Immediately"
      }
    },
    {
      "condition": "pcv_mode",
      "condition-type": "continual",
      "response": "inspiratory_time_eq_60_times_ito_e_pcv_div_rr_pcv_times_1_plus_ito_e_pcv",
      "timing": {
        "type": "Immediately"
      }
    },
    {
      "condition": "(rm) & (!rm_button)",
      "condition-type": "trigger",
      "response": "(!rm & expiration_phase_start)",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "expiratory_state",
      "condition-type": "continual",
      "response": "(in_valve_close & out_valve_open)",
      "timing": {
        "type": "Immediately"
      }
    },
    {
      "condition": "(power_off & !power_button)",
      "condition-type": "trigger",
      "response": "!start_up_mode",
      "timing": {
        "type": "Always"
      }
    },
    {
      "condition": "inspiratory_pause",
      "condition-type": "trigger",
      "response": "(!inspiratory_pause & expiration_phase_start)",
      "timing": {
        "type": "AfterTicks",
        "ticks": 3
      }
    },
    {
      "condition": "psv_mode",
      "condition-type": "continual",
      "response": "((min_expiratory_time_ge_0p4 & min_expiratory_time_le_2) & (expiratory_phase -> min_expiratory_time_eq_insp_clock_div_2))",
      "timing": {
        "type": "Immediately"
      }
    },
    {
      "condition": "(start_up_mode) & ((adc_retries_ge_5 & (adc_conn_failure | adc_error)))",
      "condition-type": "trigger",
      "response": "fail_safe_mode",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "(psv_mode) & (exp_clock_ge_apnea_lag_time)",
      "condition-type": "trigger",
      "response": "((((apnea & pcv_mode) & rr_eq_rr_ap) & p_insp_eq_p_insp_ap) & ito_e_eq_ito_e_ap)",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "((psv_mode & expiratory_phase)) & (drop_paw_gt_its_psv)",
      "condition-type": "trigger",
      "response": "patient_breathing_request",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "(pcv_mode) & ((inspiratory_phase_end & psv_mode_selected))",
      "condition-type": "trigger",
      "response": "(ventilating & psv_mode)",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "(pcv_mode) & (stop_ventilation)",
      "condition-type": "trigger",
      "response": "standby_mode",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "(psv_mode) & (breathing_cycle_start_2)",
      "condition-type": "trigger",
      "response": "inspiratory_phase_start",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "p_insp_gt_max_p_insp",
      "condition-type": "trigger",
      "response": "(inspiratory_phase_end & expiration_phase_start)",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "power_off",
      "condition-type": "trigger",
      "response": "final_state",
      "timing": {
        "type": "NextTimepoint"
      }
    },
    {
      "condition": "final_state",
      "condition-type": "trigger",
      "response": "(parameters_stored & off)",
      "timing": {
        "type": "Eventually"
      }
    }
  ],
