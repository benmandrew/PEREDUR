# Help tools that honor '.gitignore' (redundant for Git itself).
/.git

/CMakeUserPresets.json

# Common build directories
/build*/

# Raw profiles from a coverage-instrumented binary run without
# LLVM_PROFILE_FILE set, which lands wherever it was invoked from.
*.profraw

# CI jobs that run in symlinked trees produce these artifacts.
/real_work/
/work

# MacOS Finder files.
.DS_Store

# Python compile output. The directory as well as the files: running either
# suite under scripts/ creates it, and *.pyc alone leaves it showing as
# untracked in every subsequent git status.
*.pyc
__pycache__/

# See Utilities/Sphinx/tutorial_archive.cmake
/Help/_generated

# CLion work directory
/.idea/
# CLion build directories
/cmake-build-*/

# QtCreator files.
/CMakeLists.txt.user*

# Visual Studio Code
/.vscode/
/.cache/

# Visual Studio work directory
/.vs/
# Visual Studio build directory
/out/

# clang-tidy output
/clang-tidy-fixes.patch

Temporary/

.vscode/
.direnv/
crashes/
results*/
.claude/*
!.claude/skills/
.venv/

# FRET semantics reference paper (large binary / copyright)
semantics.pdf
semantics.txt

# Experiment outputs (generated at runtime). Ignored by content rather than by
# directory: git will not re-include a file whose parent directory is excluded,
# so `/experiments*/` would make the negations below dead letters. Descent stops
# at the campaign subdirectory — run dirs and CSVs are never walked.
/experiments*/*
!/experiments/README.md
!/experiments/*/
/experiments/*/*
!/experiments/*/PROVENANCE.json
# A campaign's pre-registered plan, where one was written before it launched.
# Worth tracking only because the decision rule has to be checkable against the
# result it was meant to bind; the root PLAN.md is ignored for the opposite
# reason, being a working file with no such claim on it.
!/experiments/*/PLAN.md
# A finding a campaign's data establishes about the engine rather than about the
# campaign's own factors. Tracked for the same reason as the plan: it makes a
# claim about the code that a later reader has to be able to check against the
# rows it was drawn from, and those rows live in this directory.
!/experiments/*/REPORT.md
# A campaign's declaration: the branch, the per-host seed split and the phases
# scripts/campaign.py drives it from. Tracked because it has to reach the lab
# machines, which get it by checking out the campaign's branch, and because the
# seed split is the one number a rerun has to reproduce exactly. Queue entries
# under experiments/queue/ stay ignored for the opposite reason — a tick
# rewrites their state, and a tracked file doing that leaves the checkout dirty,
# which is what campaign.py stage refuses to touch.
!/experiments/*/campaign.toml
# Retrofitted copies of the drivers each campaign ran, recovered from history.
# Same problem one level down: re-open descent into scripts/ before negating,
# then re-exclude its contents so only the .py files come back.
!/experiments/*/scripts/
/experiments/*/scripts/*
!/experiments/*/scripts/*.py
# A campaign whose launch driver is a shell script rather than a Python one
# still has to vendor it, or PROVENANCE.json names a blob the tree does not
# hold (2026-08-07-elitism/scripts/campaign_driver.sh is the first).
!/experiments/*/scripts/*.sh
# And one whose analysis needed a new PEREDUR binary vendors that binary's
# source, since the reproduction step is a compile rather than an invocation
# (2026-08-14-aurus-h2h/scripts/maximal.cpp is the first).
!/experiments/*/scripts/*.cpp
# scripts/merge_experiments.py scratch dir + per-run results (also covered by
# /experiments/, but kept explicit so they stay ignored if that's relaxed).
.merge_tmp/
results/

# Experiment planning (not committed). Anchored: unanchored, it matches at every
# depth and silently outranks the campaign-plan negation above, which is later in
# the file only by accident of grouping.
/PLAN.md
